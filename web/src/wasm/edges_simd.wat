;; Edge gradients of the high-resolution image: the same arithmetic as edgeGradients() in JavaScript
;; (f64 math, f32 stores at the same points), so the results are bit-identical.
;; Memory (byte offsets given by the caller): D = RGBA input, NMS = f32 output (n), CAND/CGX/CGY = ridge pixels,
;; RING = scratch rows (17 * W f32).
(module
  (memory (export "mem") 1)
  (global $maxM (mut f64) (f64.const 0))
  (global $W (mut i32) (i32.const 0))
  (global $H (mut i32) (i32.const 0))
  (global $D (mut i32) (i32.const 0))
  (global $RING (mut i32) (i32.const 0))
  (global $nextT (mut i32) (i32.const 0))
  (global $nextB (mut i32) (i32.const 0))
  (func (export "maxM") (result f64) (global.get $maxM))

  ;; address of f32 element i of the ring area
  (func $r (param $i i32) (result i32) (i32.add (global.get $RING) (i32.shl (local.get $i) (i32.const 2))))
  (func $ld (param $i i32) (result f64) (f64.promote_f32 (f32.load (call $r (local.get $i)))))
  (func $st (param $i i32) (param $v f64) (f32.store (call $r (local.get $i)) (f32.demote_f64 (local.get $v))))
  (func $ld2 (param $i i32) (result v128) (f64x2.promote_low_f32x4 (v128.load64_zero (call $r (local.get $i)))))
  (func $st2 (param $i i32) (param $v v128) (v128.store64_lane 0 (call $r (local.get $i)) (f32x4.demote_f64x2_zero (local.get $v))))


  ;; luma of image row nextT, blurred horizontally into tR slot (q % 5) at ring W + slot*W
  (func $pushT
    (local $q i32) (local $t i32) (local $x i32) (local $o i32) (local $W i32) (local $e i32)
    (local $a0 f64) (local $p2 f64) (local $p1 f64) (local $p0 f64) (local $n1 f64) (local $n2 f64)
    (local $x1 i32) (local $x2 i32) (local $x3 i32) (local $x4 i32)
    (local.set $W (global.get $W))
    (local.set $q (global.get $nextT))
    (global.set $nextT (i32.add (local.get $q) (i32.const 1)))
    (local.set $t (i32.add (local.get $W) (i32.mul (i32.rem_u (local.get $q) (i32.const 5)) (local.get $W))))
    ;; luma row → lum[0..W)
    (local.set $o (i32.add (global.get $D) (i32.shl (i32.mul (local.get $q) (local.get $W)) (i32.const 2))))
    (local.set $x (i32.const 0))
    (block $done (loop $lp
      (br_if $done (i32.ge_s (local.get $x) (local.get $W)))
      (call $st (local.get $x)
        (f64.mul
          (f64.div
            (f64.add
              (f64.add
                (f64.mul (f64.const 0.299) (f64.convert_i32_u (i32.load8_u (local.get $o))))
                (f64.mul (f64.const 0.587) (f64.convert_i32_u (i32.load8_u offset=1 (local.get $o)))))
              (f64.mul (f64.const 0.114) (f64.convert_i32_u (i32.load8_u offset=2 (local.get $o)))))
            (f64.const 255))
          (f64.div (f64.convert_i32_u (i32.load8_u offset=3 (local.get $o))) (f64.const 255))))
      (local.set $o (i32.add (local.get $o) (i32.const 4)))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $lp)))
    (if (i32.lt_s (local.get $W) (i32.const 5))
      (then
        ;; generic clamped kernel
        (local.set $x (i32.const 0))
        (block $d2 (loop $l2
          (br_if $d2 (i32.ge_s (local.get $x) (local.get $W)))
          (local.set $x1 (select (i32.sub (local.get $x) (i32.const 1)) (i32.const 0) (i32.gt_s (local.get $x) (i32.const 0))))
          (local.set $x2 (select (i32.sub (local.get $x) (i32.const 2)) (local.get $x1) (i32.gt_s (local.get $x) (i32.const 1))))
          (local.set $x3 (select (i32.add (local.get $x) (i32.const 1)) (local.get $x) (i32.lt_s (local.get $x) (i32.sub (local.get $W) (i32.const 1)))))
          (local.set $x4 (select (i32.add (local.get $x) (i32.const 2)) (local.get $x3) (i32.lt_s (local.get $x) (i32.sub (local.get $W) (i32.const 2)))))
          (call $st (i32.add (local.get $t) (local.get $x))
            (f64.div
              (f64.add (f64.add (f64.add (f64.add
                (call $ld (local.get $x2))
                (f64.mul (f64.const 4) (call $ld (local.get $x1))))
                (f64.mul (f64.const 6) (call $ld (local.get $x))))
                (f64.mul (f64.const 4) (call $ld (local.get $x3))))
                (call $ld (local.get $x4)))
              (f64.const 16)))
          (local.set $x (i32.add (local.get $x) (i32.const 1)))
          (br $l2)))
        (return)))
    (local.set $e (i32.sub (local.get $W) (i32.const 1)))
    (local.set $a0 (call $ld (i32.const 0)))
    ;; t[0] = (a0 + 4*a0 + 6*a0 + 4*a1 + a2) / 16
    (call $st (local.get $t)
      (f64.div (f64.add (f64.add (f64.add (f64.add (local.get $a0) (f64.mul (f64.const 4) (local.get $a0))) (f64.mul (f64.const 6) (local.get $a0))) (f64.mul (f64.const 4) (call $ld (i32.const 1)))) (call $ld (i32.const 2))) (f64.const 16)))
    ;; t[1] = (a0 + 4*a0 + 6*a1 + 4*a2 + a3) / 16
    (call $st (i32.add (local.get $t) (i32.const 1))
      (f64.div (f64.add (f64.add (f64.add (f64.add (local.get $a0) (f64.mul (f64.const 4) (local.get $a0))) (f64.mul (f64.const 6) (call $ld (i32.const 1)))) (f64.mul (f64.const 4) (call $ld (i32.const 2)))) (call $ld (i32.const 3))) (f64.const 16)))
    (local.set $x (i32.const 2))
    (block $h3 (loop $hl
      (br_if $h3 (i32.gt_s (i32.add (local.get $x) (i32.const 2)) (i32.sub (local.get $e) (i32.const 1))))
      (call $st2 (i32.add (local.get $t) (local.get $x))
        (f64x2.div (f64x2.add (f64x2.add (f64x2.add (f64x2.add
          (call $ld2 (i32.sub (local.get $x) (i32.const 2)))
          (f64x2.mul (f64x2.splat (f64.const 4)) (call $ld2 (i32.sub (local.get $x) (i32.const 1)))))
          (f64x2.mul (f64x2.splat (f64.const 6)) (call $ld2 (local.get $x))))
          (f64x2.mul (f64x2.splat (f64.const 4)) (call $ld2 (i32.add (local.get $x) (i32.const 1)))))
          (call $ld2 (i32.add (local.get $x) (i32.const 2))))
          (f64x2.splat (f64.const 16))))
      (local.set $x (i32.add (local.get $x) (i32.const 2)))
      (br $hl)))
    (local.set $p2 (call $ld (i32.sub (local.get $x) (i32.const 2)))) (local.set $p1 (call $ld (i32.sub (local.get $x) (i32.const 1)))) (local.set $p0 (call $ld (local.get $x))) (local.set $n1 (call $ld (i32.add (local.get $x) (i32.const 1))))
    (block $d3 (loop $l3
      (br_if $d3 (i32.ge_s (local.get $x) (i32.sub (local.get $e) (i32.const 1))))
      (local.set $n2 (call $ld (i32.add (local.get $x) (i32.const 2))))
      (call $st (i32.add (local.get $t) (local.get $x))
        (f64.div (f64.add (f64.add (f64.add (f64.add (local.get $p2) (f64.mul (f64.const 4) (local.get $p1))) (f64.mul (f64.const 6) (local.get $p0))) (f64.mul (f64.const 4) (local.get $n1))) (local.get $n2)) (f64.const 16)))
      (local.set $p2 (local.get $p1)) (local.set $p1 (local.get $p0)) (local.set $p0 (local.get $n1)) (local.set $n1 (local.get $n2))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $l3)))
    ;; t[e-1] = (a[e-3] + 4a[e-2] + 6a[e-1] + 4a[e] + a[e]) / 16 ; t[e] = (a[e-2] + 4a[e-1] + 6a[e] + 4a[e] + a[e]) / 16
    (call $st (i32.add (local.get $t) (i32.sub (local.get $e) (i32.const 1)))
      (f64.div (f64.add (f64.add (f64.add (f64.add (call $ld (i32.sub (local.get $e) (i32.const 3))) (f64.mul (f64.const 4) (call $ld (i32.sub (local.get $e) (i32.const 2))))) (f64.mul (f64.const 6) (call $ld (i32.sub (local.get $e) (i32.const 1))))) (f64.mul (f64.const 4) (call $ld (local.get $e)))) (call $ld (local.get $e))) (f64.const 16)))
    (call $st (i32.add (local.get $t) (local.get $e))
      (f64.div (f64.add (f64.add (f64.add (f64.add (call $ld (i32.sub (local.get $e) (i32.const 2))) (f64.mul (f64.const 4) (call $ld (i32.sub (local.get $e) (i32.const 1))))) (f64.mul (f64.const 6) (call $ld (local.get $e)))) (f64.mul (f64.const 4) (call $ld (local.get $e)))) (call $ld (local.get $e))) (f64.const 16))))

  ;; vertical blur of row nextB → bR slot (y % 3) at ring 6W + slot*W
  (func $pushB
    (local $y i32) (local $W i32) (local $H i32) (local $lim i32) (local $y1 i32) (local $y2 i32) (local $y3 i32) (local $y4 i32)
    (local $r0 i32) (local $r1 i32) (local $r2 i32) (local $r3 i32) (local $r4 i32) (local $b i32) (local $x i32)
    (local.set $W (global.get $W)) (local.set $H (global.get $H))
    (local.set $y (global.get $nextB))
    (global.set $nextB (i32.add (local.get $y) (i32.const 1)))
    (local.set $lim (select (i32.sub (local.get $H) (i32.const 1)) (i32.add (local.get $y) (i32.const 2)) (i32.lt_s (i32.sub (local.get $H) (i32.const 1)) (i32.add (local.get $y) (i32.const 2)))))
    (block $d (loop $l (br_if $d (i32.gt_s (global.get $nextT) (local.get $lim))) (call $pushT) (br $l)))
    (local.set $y1 (select (i32.sub (local.get $y) (i32.const 1)) (i32.const 0) (i32.gt_s (local.get $y) (i32.const 0))))
    (local.set $y2 (select (i32.sub (local.get $y) (i32.const 2)) (local.get $y1) (i32.gt_s (local.get $y) (i32.const 1))))
    (local.set $y3 (select (i32.add (local.get $y) (i32.const 1)) (local.get $y) (i32.lt_s (local.get $y) (i32.sub (local.get $H) (i32.const 1)))))
    (local.set $y4 (select (i32.add (local.get $y) (i32.const 2)) (local.get $y3) (i32.lt_s (local.get $y) (i32.sub (local.get $H) (i32.const 2)))))
    (local.set $r0 (i32.add (local.get $W) (i32.mul (i32.rem_u (local.get $y) (i32.const 5)) (local.get $W))))
    (local.set $r1 (i32.add (local.get $W) (i32.mul (i32.rem_u (local.get $y1) (i32.const 5)) (local.get $W))))
    (local.set $r2 (i32.add (local.get $W) (i32.mul (i32.rem_u (local.get $y2) (i32.const 5)) (local.get $W))))
    (local.set $r3 (i32.add (local.get $W) (i32.mul (i32.rem_u (local.get $y3) (i32.const 5)) (local.get $W))))
    (local.set $r4 (i32.add (local.get $W) (i32.mul (i32.rem_u (local.get $y4) (i32.const 5)) (local.get $W))))
    (local.set $b (i32.add (i32.mul (i32.const 6) (local.get $W)) (i32.mul (i32.rem_u (local.get $y) (i32.const 3)) (local.get $W))))
    (local.set $x (i32.const 0))
    (block $v2 (loop $vl
      (br_if $v2 (i32.gt_s (i32.add (local.get $x) (i32.const 2)) (local.get $W)))
      (call $st2 (i32.add (local.get $b) (local.get $x))
        (f64x2.div (f64x2.add (f64x2.add (f64x2.add (f64x2.add
          (call $ld2 (i32.add (local.get $r2) (local.get $x)))
          (f64x2.mul (f64x2.splat (f64.const 4)) (call $ld2 (i32.add (local.get $r1) (local.get $x)))))
          (f64x2.mul (f64x2.splat (f64.const 6)) (call $ld2 (i32.add (local.get $r0) (local.get $x)))))
          (f64x2.mul (f64x2.splat (f64.const 4)) (call $ld2 (i32.add (local.get $r3) (local.get $x)))))
          (call $ld2 (i32.add (local.get $r4) (local.get $x))))
          (f64x2.splat (f64.const 16))))
      (local.set $x (i32.add (local.get $x) (i32.const 2)))
      (br $vl)))
    (block $d2 (loop $l2
      (br_if $d2 (i32.ge_s (local.get $x) (local.get $W)))
      (call $st (i32.add (local.get $b) (local.get $x))
        (f64.div (f64.add (f64.add (f64.add (f64.add
          (call $ld (i32.add (local.get $r2) (local.get $x)))
          (f64.mul (f64.const 4) (call $ld (i32.add (local.get $r1) (local.get $x)))))
          (f64.mul (f64.const 6) (call $ld (i32.add (local.get $r0) (local.get $x)))))
          (f64.mul (f64.const 4) (call $ld (i32.add (local.get $r3) (local.get $x)))))
          (call $ld (i32.add (local.get $r4) (local.get $x))))
          (f64.const 16)))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $l2))))

  ;; Sobel of row y → xR/yR slot (y & 1), magnitude ring slot (y % 3) at 9W + slot*W
  (func $sobel (param $y i32)
    (local $W i32) (local $u i32) (local $c i32) (local $dn i32) (local $g i32) (local $mc i32) (local $x i32)
    (local $A f64) (local $B f64) (local $C f64) (local $D f64) (local $E f64) (local $F f64) (local $G f64) (local $H f64) (local $K f64)
    (local $colL f64) (local $colR f64) (local $X f64) (local $Y f64) (local $m f64) (local $mx f64)
    (local $vA v128) (local $vB v128) (local $vC v128) (local $vD v128) (local $vF v128) (local $vG v128) (local $vH v128) (local $vK v128) (local $vX v128) (local $vY v128) (local $vM v128)
    (local.set $W (global.get $W))
    (block $d (loop $l (br_if $d (i32.gt_s (global.get $nextB) (i32.add (local.get $y) (i32.const 1)))) (call $pushB) (br $l)))
    (local.set $u (i32.add (i32.mul (i32.const 6) (local.get $W)) (i32.mul (i32.rem_u (i32.sub (local.get $y) (i32.const 1)) (i32.const 3)) (local.get $W))))
    (local.set $c (i32.add (i32.mul (i32.const 6) (local.get $W)) (i32.mul (i32.rem_u (local.get $y) (i32.const 3)) (local.get $W))))
    (local.set $dn (i32.add (i32.mul (i32.const 6) (local.get $W)) (i32.mul (i32.rem_u (i32.add (local.get $y) (i32.const 1)) (i32.const 3)) (local.get $W))))
    (local.set $mc (i32.add (i32.mul (i32.const 9) (local.get $W)) (i32.mul (i32.rem_u (local.get $y) (i32.const 3)) (local.get $W))))
    (local.set $g (i32.mul (i32.and (local.get $y) (i32.const 1)) (local.get $W)))
    (call $st (local.get $mc) (f64.const 0))
    (call $st (i32.add (local.get $mc) (i32.sub (local.get $W) (i32.const 1))) (f64.const 0))
    (local.set $mx (global.get $maxM))
    (local.set $x (i32.const 1))
    (block $s2 (loop $sl
      (br_if $s2 (i32.gt_s (i32.add (local.get $x) (i32.const 2)) (i32.sub (local.get $W) (i32.const 1))))
      (local.set $vA (call $ld2 (i32.add (local.get $u) (i32.sub (local.get $x) (i32.const 1)))))
      (local.set $vB (call $ld2 (i32.add (local.get $u) (local.get $x))))
      (local.set $vC (call $ld2 (i32.add (local.get $u) (i32.add (local.get $x) (i32.const 1)))))
      (local.set $vD (call $ld2 (i32.add (local.get $c) (i32.sub (local.get $x) (i32.const 1)))))
      (local.set $vF (call $ld2 (i32.add (local.get $c) (i32.add (local.get $x) (i32.const 1)))))
      (local.set $vG (call $ld2 (i32.add (local.get $dn) (i32.sub (local.get $x) (i32.const 1)))))
      (local.set $vH (call $ld2 (i32.add (local.get $dn) (local.get $x))))
      (local.set $vK (call $ld2 (i32.add (local.get $dn) (i32.add (local.get $x) (i32.const 1)))))
      ;; X = (C + 2F + K) - (A + 2D + G), Y = (G + 2H + K) - (A + 2B + C)
      (local.set $vX (f64x2.sub
        (f64x2.add (f64x2.add (local.get $vC) (f64x2.mul (f64x2.splat (f64.const 2)) (local.get $vF))) (local.get $vK))
        (f64x2.add (f64x2.add (local.get $vA) (f64x2.mul (f64x2.splat (f64.const 2)) (local.get $vD))) (local.get $vG))))
      (local.set $vY (f64x2.sub
        (f64x2.add (f64x2.add (local.get $vG) (f64x2.mul (f64x2.splat (f64.const 2)) (local.get $vH))) (local.get $vK))
        (f64x2.add (f64x2.add (local.get $vA) (f64x2.mul (f64x2.splat (f64.const 2)) (local.get $vB))) (local.get $vC))))
      (call $st2 (i32.add (i32.mul (i32.const 13) (local.get $W)) (i32.add (local.get $g) (local.get $x))) (local.get $vX))
      (call $st2 (i32.add (i32.mul (i32.const 15) (local.get $W)) (i32.add (local.get $g) (local.get $x))) (local.get $vY))
      (local.set $vM (f64x2.div (f64x2.sqrt (f64x2.add (f64x2.mul (local.get $vX) (local.get $vX)) (f64x2.mul (local.get $vY) (local.get $vY)))) (f64x2.splat (f64.const 4))))
      (call $st2 (i32.add (local.get $mc) (local.get $x)) (local.get $vM))
      (if (f64.gt (f64x2.extract_lane 0 (local.get $vM)) (local.get $mx)) (then (local.set $mx (f64x2.extract_lane 0 (local.get $vM)))))
      (if (f64.gt (f64x2.extract_lane 1 (local.get $vM)) (local.get $mx)) (then (local.set $mx (f64x2.extract_lane 1 (local.get $vM)))))
      (local.set $x (i32.add (local.get $x) (i32.const 2)))
      (br $sl)))
    (local.set $A (call $ld (i32.add (local.get $u) (i32.sub (local.get $x) (i32.const 1))))) (local.set $B (call $ld (i32.add (local.get $u) (local.get $x))))
    (local.set $D (call $ld (i32.add (local.get $c) (i32.sub (local.get $x) (i32.const 1))))) (local.set $E (call $ld (i32.add (local.get $c) (local.get $x))))
    (local.set $G (call $ld (i32.add (local.get $dn) (i32.sub (local.get $x) (i32.const 1))))) (local.set $H (call $ld (i32.add (local.get $dn) (local.get $x))))
    (local.set $colL (f64.add (f64.add (local.get $A) (f64.mul (f64.const 2) (local.get $D))) (local.get $G)))
    (block $d2 (loop $l2
      (br_if $d2 (i32.ge_s (local.get $x) (i32.sub (local.get $W) (i32.const 1))))
      (local.set $C (call $ld (i32.add (local.get $u) (i32.add (local.get $x) (i32.const 1)))))
      (local.set $F (call $ld (i32.add (local.get $c) (i32.add (local.get $x) (i32.const 1)))))
      (local.set $K (call $ld (i32.add (local.get $dn) (i32.add (local.get $x) (i32.const 1)))))
      (local.set $colR (f64.add (f64.add (local.get $C) (f64.mul (f64.const 2) (local.get $F))) (local.get $K)))
      (local.set $X (f64.sub (local.get $colR) (local.get $colL)))
      (local.set $Y (f64.sub
        (f64.add (f64.add (local.get $G) (f64.mul (f64.const 2) (local.get $H))) (local.get $K))
        (f64.add (f64.add (local.get $A) (f64.mul (f64.const 2) (local.get $B))) (local.get $C))))
      (call $st (i32.add (i32.mul (i32.const 13) (local.get $W)) (i32.add (local.get $g) (local.get $x))) (local.get $X))
      (call $st (i32.add (i32.mul (i32.const 15) (local.get $W)) (i32.add (local.get $g) (local.get $x))) (local.get $Y))
      (local.set $m (f64.div (f64.sqrt (f64.add (f64.mul (local.get $X) (local.get $X)) (f64.mul (local.get $Y) (local.get $Y)))) (f64.const 4)))
      (call $st (i32.add (local.get $mc) (local.get $x)) (local.get $m))
      (if (f64.gt (local.get $m) (local.get $mx)) (then (local.set $mx (local.get $m))))
      (local.set $colL (f64.add (f64.add (local.get $B) (f64.mul (f64.const 2) (local.get $E))) (local.get $H)))
      (local.set $A (local.get $B)) (local.set $B (local.get $C)) (local.set $D (local.get $E)) (local.set $E (local.get $F)) (local.set $G (local.get $H)) (local.set $H (local.get $K))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $l2)))
    (global.set $maxM (local.get $mx)))

  ;; magnitude ring row of image row y (border rows: the zero row)
  (func $magRow (param $y i32) (result i32)
    (if (result i32) (i32.or (i32.le_s (local.get $y) (i32.const 0)) (i32.ge_s (local.get $y) (i32.sub (global.get $H) (i32.const 1))))
      (then (i32.mul (i32.const 12) (global.get $W)))
      (else (i32.add (i32.mul (i32.const 9) (global.get $W)) (i32.mul (i32.rem_u (local.get $y) (i32.const 3)) (global.get $W))))))

  ;; the whole image: returns the number of ridge pixels (written to CAND/CGX/CGY in pixel order)
  (func (export "edges") (param $D i32) (param $W i32) (param $H i32) (param $NMS i32) (param $CAND i32) (param $CGX i32) (param $CGY i32) (param $RING i32) (param $lean i32) (result i32)
    (local $nc i32) (local $y i32) (local $x i32) (local $i i32) (local $up i32) (local $c i32) (local $dn i32) (local $g i32) (local $fo i32)
    (local $T f64) (local $m f64) (local $X f64) (local $Y f64) (local $ax f64) (local $ay f64) (local $n1 f64) (local $n2 f64) (local $k i32) (local $n i32)
    (global.set $D (local.get $D)) (global.set $W (local.get $W)) (global.set $H (local.get $H)) (global.set $RING (local.get $RING))
    (global.set $nextT (i32.const 0)) (global.set $nextB (i32.const 0)) (global.set $maxM (f64.const 0))
    (local.set $n (i32.mul (local.get $W) (local.get $H)))
    ;; zero row of the magnitude ring; border rows of nms
    (local.set $x (i32.const 0))
    (block $z (loop $zl (br_if $z (i32.ge_s (local.get $x) (local.get $W)))
      (call $st (i32.add (i32.mul (i32.const 12) (local.get $W)) (local.get $x)) (f64.const 0))
      (f32.store (i32.add (local.get $NMS) (i32.shl (local.get $x) (i32.const 2))) (f32.const 0))
      (f32.store (i32.add (local.get $NMS) (i32.shl (i32.add (i32.sub (local.get $n) (local.get $W)) (local.get $x)) (i32.const 2))) (f32.const 0))
      (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $zl)))
    (call $sobel (i32.const 1))
    (local.set $y (i32.const 1))
    (block $done (loop $rows
      (br_if $done (i32.ge_s (local.get $y) (i32.sub (local.get $H) (i32.const 1))))
      (if (i32.lt_s (i32.add (local.get $y) (i32.const 1)) (i32.sub (local.get $H) (i32.const 1))) (then (call $sobel (i32.add (local.get $y) (i32.const 1)))))
      ;; ridge test of row y
      (local.set $up (call $magRow (i32.sub (local.get $y) (i32.const 1))))
      (local.set $c (call $magRow (local.get $y)))
      (local.set $dn (call $magRow (i32.add (local.get $y) (i32.const 1))))
      (local.set $g (i32.mul (i32.and (local.get $y) (i32.const 1)) (local.get $W)))
      (local.set $fo (i32.mul (local.get $y) (local.get $W)))
      (local.set $T (select
        (f64.max (f64.max (f64.const 0.005) (f64.const 0.0055)) (f64.mul (f64.const 0.035) (global.get $maxM)))
        (f64.const 0.005)
        (local.get $lean)))
      (f32.store (i32.add (local.get $NMS) (i32.shl (local.get $fo) (i32.const 2))) (f32.const 0))
      (f32.store (i32.add (local.get $NMS) (i32.shl (i32.add (local.get $fo) (i32.sub (local.get $W) (i32.const 1))) (i32.const 2))) (f32.const 0))
      (local.set $x (i32.const 1))
      (block $rd (loop $rl
        (br_if $rd (i32.ge_s (local.get $x) (i32.sub (local.get $W) (i32.const 1))))
        (local.set $i (i32.add (local.get $fo) (local.get $x)))
        (local.set $m (call $ld (i32.add (local.get $c) (local.get $x))))
        (if (f64.lt (local.get $m) (local.get $T))
          (then (f32.store (i32.add (local.get $NMS) (i32.shl (local.get $i) (i32.const 2))) (f32.const 0)))
          (else
            (local.set $X (call $ld (i32.add (i32.mul (i32.const 13) (local.get $W)) (i32.add (local.get $g) (local.get $x)))))
            (local.set $Y (call $ld (i32.add (i32.mul (i32.const 15) (local.get $W)) (i32.add (local.get $g) (local.get $x)))))
            (local.set $ax (f64.abs (local.get $X))) (local.set $ay (f64.abs (local.get $Y)))
            (if (f64.le (local.get $ay) (f64.mul (local.get $ax) (f64.const 0.4142)))
              (then
                (local.set $n1 (call $ld (i32.add (local.get $c) (i32.sub (local.get $x) (i32.const 1)))))
                (local.set $n2 (call $ld (i32.add (local.get $c) (i32.add (local.get $x) (i32.const 1))))))
              (else
                (if (f64.ge (local.get $ay) (f64.mul (local.get $ax) (f64.const 2.4142)))
                  (then
                    (local.set $n1 (call $ld (i32.add (local.get $up) (local.get $x))))
                    (local.set $n2 (call $ld (i32.add (local.get $dn) (local.get $x)))))
                  (else
                    (if (f64.gt (f64.mul (local.get $X) (local.get $Y)) (f64.const 0))
                      (then
                        (local.set $n1 (call $ld (i32.add (local.get $up) (i32.sub (local.get $x) (i32.const 1)))))
                        (local.set $n2 (call $ld (i32.add (local.get $dn) (i32.add (local.get $x) (i32.const 1))))))
                      (else
                        (local.set $n1 (call $ld (i32.add (local.get $up) (i32.add (local.get $x) (i32.const 1)))))
                        (local.set $n2 (call $ld (i32.add (local.get $dn) (i32.sub (local.get $x) (i32.const 1)))))))))))
            (if (i32.and (f64.ge (local.get $m) (local.get $n1)) (f64.gt (local.get $m) (local.get $n2)))
              (then
                (f32.store (i32.add (local.get $NMS) (i32.shl (local.get $i) (i32.const 2))) (f32.demote_f64 (local.get $m)))
                (local.set $k (i32.shl (local.get $nc) (i32.const 2)))
                (i32.store (i32.add (local.get $CAND) (local.get $k)) (local.get $i))
                (f32.store (i32.add (local.get $CGX) (local.get $k)) (f32.demote_f64 (local.get $X)))
                (f32.store (i32.add (local.get $CGY) (local.get $k)) (f32.demote_f64 (local.get $Y)))
                (local.set $nc (i32.add (local.get $nc) (i32.const 1))))
              (else (f32.store (i32.add (local.get $NMS) (i32.shl (local.get $i) (i32.const 2))) (f32.const 0))))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br $rl)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $rows)))
    (local.get $nc))
)
