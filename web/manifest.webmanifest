{
  "name": "Image to Text Converter",
  "short_name": "Image to Text",
  "description": "Turn pictures, GIFs and videos into text art. Works offline; nothing is uploaded.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0f14",
  "theme_color": "#0d0f14",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".avif",
          ".bmp",
          ".svg",
          ".apng"
        ],
        "video/*": [
          ".mp4",
          ".webm",
          ".mov",
          ".mkv"
        ],
        "text/plain": [
          ".txt",
          ".ans",
          ".nfo"
        ],
        "application/x-textart+zip": [
          ".textart"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
